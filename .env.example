# Choose a local password; use URL-safe letters and digits for the Compose URL.
POSTGRES_PASSWORD=replace_this_local_password
MIGHTYEYE_MODE=live
# For a non-container process:
# DATABASE_URL=postgresql+psycopg://mightyeye:password@127.0.0.1:5432/mightyeye
# EVIDENCE_ROOT=output/evidence
# MIGHTYEYE_RULES=config/rules.json
